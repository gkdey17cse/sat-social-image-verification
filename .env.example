# --- Provider selection ---
# Options: "ollama" (local, no API key), "gemini", "openrouter"
API_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5vl:3b

# --- Gemini (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenRouter (optional) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- Layer 1 thresholds ---
NSFW_BLOCK_THRESHOLD=0.95
NSFW_PASS_THRESHOLD=0.15

# --- Storage ---
DB_PATH=moderation.db
UPLOAD_DIR=uploads

# --- Worker autostart (not recommended with --reload) ---
AUTO_START_WORKER=false